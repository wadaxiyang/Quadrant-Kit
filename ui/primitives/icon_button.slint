import { Button } from "std-widgets.slint";
import { Theme } from "../foundation/theme.slint";
import { UiConstants } from "../foundation/constants.slint";
import { TooltipHost } from "tooltip_host.slint";

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <string> accessible_name;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: command.has-focus;
    out property <bool> pressed: command.pressed;
    callback clicked;

    width: max(UiConstants.icon_button_size, command.min-width);
    height: max(UiConstants.icon_button_size, command.min-height);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: command;

    command := Button {
        width: 100%; height: 100%;
        icon: root.icon;
        icon-size: 20px;
        colorize-icon: true;
        enabled: root.enabled;
        accessible-label: root.accessible_name == "" ? root.tooltip : root.accessible_name;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    if root.danger: Rectangle {
        x: -2px; y: -2px;
        width: parent.width + 4px; height: parent.height + 4px;
        background: transparent;
        border-radius: 6px; border-width: 1px;
        border-color: root.enabled ? Theme.danger : Theme.text_tertiary;
        accessible-role: none;
    }
    Tooltip { TooltipHost { text: root.tooltip; shown: true; } }
}
