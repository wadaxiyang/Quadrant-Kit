// Derived from wsl-dashboard src/ui/components/common.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd.

import { Elevation, Theme } from "../foundation/theme.slint";
import { UiConstants } from "../foundation/constants.slint";

export component SurfaceCard inherits Rectangle {
    in property <bool> interactive: false;
    in property <bool> elevated: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <string> accessible_name;
    callback clicked;
    private property <bool> hovered: false;
    private property <bool> pressed: false;
    changed interactive => { if (!root.interactive) { root.hovered = false; root.pressed = false; } }

    background: root.selected ? Elevation.card_selected_surface :
                root.interactive && root.enabled && root.pressed ? Elevation.card_pressed_surface :
                root.interactive && root.enabled && root.hovered ? Elevation.card_hover_surface : Elevation.card_surface;
    border-width: (root.interactive && root.enabled && card_focus.has-focus) ? 2px : 1px;
    border-color: (root.interactive && root.enabled && card_focus.has-focus) ? Theme.focus_ring :
                  root.selected ? Elevation.card_selected_border : Elevation.card_border;
    border-radius: UiConstants.content_radius;
    drop-shadow-blur: root.elevated ? Elevation.card_blur : 0px;
    drop-shadow-color: root.elevated ? Elevation.card_shadow : transparent;
    forward-focus: card_focus;
    accessible-role: none;

    if root.interactive: Rectangle {
        accessible-role: button;
        accessible-label: root.accessible_name;
        accessible-enabled: root.enabled;
        accessible-checkable: true;
        accessible-checked: root.selected;
        accessible-action-default => { if (root.enabled) { root.clicked(); } }
    }

    if root.interactive: TouchArea {
        changed has-hover => { root.hovered = self.has-hover; }
        changed pressed => { root.pressed = self.pressed; }
        enabled: root.interactive && root.enabled;
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }

    card_focus := FocusScope {
        width: 0px;
        enabled: root.interactive && root.enabled;
        key-pressed(event) => {
            if (root.interactive && root.enabled && (event.text == Key.Return || event.text == Key.Space)) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
