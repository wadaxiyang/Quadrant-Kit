// Derived from wsl-dashboard src/ui/components/common.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd.

import { Button } from "std-widgets.slint";

export component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible_name;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: command.has-focus;
    out property <bool> pressed: command.pressed;
    callback clicked;

    preferred-width: command.min-width;
    preferred-height: command.min-height;
    width: command.min-width;
    height: command.min-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: command;

    command := Button {
        width: 100%; height: 100%;
        text: root.text;
        enabled: root.enabled;
        // Native activation never toggles state. Only the host owns selected.
        checkable: false;
        checked: root.selected;
        accessible-checkable: true;
        accessible-checked: root.selected;
        accessible-label: root.accessible_name == "" ? root.text : root.accessible_name;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}
