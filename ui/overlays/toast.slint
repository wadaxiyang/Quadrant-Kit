import { Elevation, Theme, Typography } from "../foundation/theme.slint";
import { UiConstants } from "../foundation/constants.slint";
import { FluentIcons as Icons } from "../foundation/fluent_icons.slint";
import { FluentIcon } from "../primitives/fluent_icon.slint";
import { IconButton } from "../primitives/icon_button.slint";

export enum ToastKind { info, success, error }

export component ToastHost inherits Rectangle {
    in property <bool> shown: false;
    in property <string> message;
    in property <ToastKind> kind: ToastKind.info;
    in property <bool> auto_dismiss: true;
    callback dismissed;
    private property <bool> close_requested: false;
    changed shown => { root.close_requested = false; }
    function request_dismiss() {
        if root.shown && root.visible && !root.close_requested {
            root.close_requested = true;
            root.dismissed();
        }
    }

    min-width: 280px;
    preferred-width: 360px;
    max-width: 420px;
    horizontal-stretch: 0;
    height: root.shown ? 56px : 0px;
    background: Theme.card_bg;
    border-width: root.shown ? 1px : 0px;
    border-color: root.kind == ToastKind.error ? Theme.danger :
                  root.kind == ToastKind.success ? Theme.success : Theme.accent;
    border-radius: 6px;
    clip: true;
    drop-shadow-blur: Elevation.popup_blur;
    drop-shadow-color: Elevation.popup_shadow;

    if root.shown && root.visible: Rectangle {
        width: 100%; height: 100%;

        Rectangle {
            x: 0px;
            width: 4px;
            height: 100%;
            background: root.kind == ToastKind.error ? Theme.danger :
                        root.kind == ToastKind.success ? Theme.success : Theme.accent;
        }

        // Passive hover tracking keeps the toast readable without intercepting
        // clicks from the dismiss button above it.
        toast_touch := TouchArea { }

        toast_layout := HorizontalLayout {
            padding-left: UiConstants.space_16;
            padding-right: UiConstants.space_8;
            padding-top: UiConstants.space_8;
            padding-bottom: UiConstants.space_8;
            spacing: UiConstants.space_8;

            FluentIcon {
                source: root.kind == ToastKind.error ? Icons.status_error :
                        root.kind == ToastKind.success ? Icons.status_success : Icons.status_info;
                size: 24px;
                icon_color: root.kind == ToastKind.error ? Theme.danger :
                            root.kind == ToastKind.success ? Theme.success : Theme.accent;
            }

            Text {
                horizontal-stretch: 1;
                text: root.message;
                color: Theme.text_primary;
                font-size: Typography.body;
                vertical-alignment: center;
                wrap: word-wrap;
                max-height: 40px;
                overflow: elide;
            }

            IconButton {
                icon: Icons.dismiss;
                tooltip: "Dismiss";
                enabled: !root.close_requested;
                clicked => { root.request_dismiss(); }
            }
        }

        Timer {
            running: root.auto_dismiss && !root.close_requested && !toast_touch.has-hover;
            interval: 4000ms;
            triggered => { root.request_dismiss(); }
        }
    }
}
