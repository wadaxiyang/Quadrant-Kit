// Derived from the overlay/manager pattern in wsl-dashboard
// src/ui/components/modal_manager.slint at 948589a255a4bd8a3ff9c3de49e2e13109378fcd.
// WSL-specific dialogs and data were removed in favor of one reusable shell.

import { Elevation, Motion, Theme, Typography } from "../foundation/theme.slint";
import { UiConstants } from "../foundation/constants.slint";
import { FluentIcons as Icons } from "../foundation/fluent_icons.slint";
import { FluentIcon } from "../primitives/fluent_icon.slint";
import { FluentButton } from "../primitives/fluent_button.slint";
import { SurfaceCard } from "../primitives/surface_card.slint";

export enum ModalKind { info, warning, danger }

import { TransientLifetime } from "../primitives/private/transient_lifetime.slint";

export component ModalManager inherits Rectangle {
    in property <bool> shown: false;
    in property <string> title;
    in property <string> message;
    in property <string> primary_text: "OK";
    in property <string> secondary_text: "Cancel";
    in property <bool> show_secondary: false;
    in property <ModalKind> kind: ModalKind.info;
    in property <bool> danger_primary: false;
    out property <bool> presented: lifetime.presented;
    out property <bool> animating: lifetime.animating;
    lifetime := TransientLifetime {
        requested: root.shown && root.visible;
        duration: root.visible ? Motion.standard : 0ms;
    }
    callback accepted;
    callback dismissed;
    callback restore_focus_requested();
    private property <bool> request_made: false;
    private property <bool> was_shown: false;
    init => { root.was_shown = root.shown; }
    changed shown => {
        root.request_made = false;
        if root.shown { root.was_shown = true; }
        else if root.was_shown {
            root.was_shown = false;
            root.restore_focus_requested();
        }
    }
    function request_accept() {
        if root.shown && root.visible && !root.request_made { root.request_made = true; root.accepted(); }
    }
    function request_dismiss() {
        if root.shown && root.visible && !root.request_made { root.request_made = true; root.dismissed(); }
    }
    if root.presented: FocusScope {
        enabled: root.shown && root.visible;
        opacity: lifetime.progress;
        private property <bool> active: root.shown && root.visible;
        changed active => { if self.active { if root.show_secondary { secondary.focus(); } else { primary.focus(); } } }
        width: 100%; height: 100%;
        focus-on-tab-navigation: false;
        init => { if self.active { if root.show_secondary { secondary.focus(); } else { primary.focus(); } } }
        capture-key-pressed(event) => {
            if !root.shown || !root.visible { return reject; }
            if event.text == Key.Escape { root.request_dismiss(); return accept; }
            if event.text == Key.Tab && !event.modifiers.control && !event.modifiers.alt {
                if root.show_secondary && primary.has-focus { secondary.focus(); }
                else { primary.focus(); }
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: 100%; height: 100%; background: Elevation.dialog_overlay;
            TouchArea { enabled: root.shown && root.visible; }
        }
        SurfaceCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 48px, 420px);
            height: max(176px, modal_layout.preferred-height);
            background: Elevation.dialog_surface;
            border-color: Elevation.dialog_border;
            drop-shadow-blur: Elevation.dialog_blur;
            drop-shadow-color: Elevation.dialog_shadow;
            modal_layout := VerticalLayout {
                padding: UiConstants.space_24;
                spacing: UiConstants.space_16;
                HorizontalLayout {
                    spacing: UiConstants.space_12;
                    alignment: center;
                    FluentIcon {
                        source: root.kind == ModalKind.danger ? Icons.status_error :
                                root.kind == ModalKind.warning ? Icons.status_warning : Icons.status_info;
                        size: 24px;
                        icon_color: root.kind == ModalKind.danger ? Theme.danger :
                                    root.kind == ModalKind.warning ? Theme.warning : Theme.accent;
                    }
                    Text {
                        text: root.title; color: Theme.text_primary;
                        font-size: Typography.subtitle; font-weight: Typography.semibold;
                        vertical-alignment: center; overflow: elide;
                    }
                }
                Text { text: root.message; color: Theme.text_secondary;
                    font-size: Typography.body; wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    secondary := FluentButton {
                        width: 92px; text: root.secondary_text;
                        visible: root.show_secondary; enabled: root.shown && root.visible && root.show_secondary;
                        clicked => { root.request_dismiss(); }
                    }
                    primary := FluentButton {
                        width: 92px; text: root.primary_text;
                        primary: true; danger: root.danger_primary; enabled: root.shown && root.visible;
                        clicked => { root.request_accept(); }
                    }
                }
            }
        }
    }
}
