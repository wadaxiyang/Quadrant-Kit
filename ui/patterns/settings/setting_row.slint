// Derived from wsl-dashboard src/ui/components/common.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd.

import { Theme, Typography } from "../../foundation/theme.slint";
import { UiConstants } from "../../foundation/constants.slint";

export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;

    min-height: 64px;
    // Slot controls bind enabled to the same host source; no recursive disabling.
    preferred-height: max(root.min-height, row_layout.preferred-height);
    vertical-stretch: 0;
    accessible-role: groupbox;
    accessible-label: root.title;
    accessible-description: root.description;

    row_layout := HorizontalLayout {
        padding-top: UiConstants.space_10;
        padding-bottom: UiConstants.space_10;
        spacing: UiConstants.space_16;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: UiConstants.space_4;

            Text {
                text: root.title;
                wrap: word-wrap;
                color: root.enabled ? Theme.text_primary : Theme.text_disabled;
                font-size: Typography.body;
                font-weight: Typography.semibold;
                vertical-alignment: center;
            }

            Text {
                text: root.description;
                color: root.enabled ? Theme.text_secondary : Theme.text_disabled;
                font-size: Typography.caption;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            @children
        }
    }
}
