import { Theme } from "../../foundation/theme.slint";
import { UiConstants } from "../../foundation/constants.slint";
import { NavigationContentSurfaceMode } from "navigation_types.slint";

export component NavigationContentSurface inherits Rectangle {
    in property <NavigationContentSurfaceMode> mode: NavigationContentSurfaceMode.fluent;
    private property <length> corner_radius: min(UiConstants.navigation_content_radius, min(root.width, root.height) / 2);

    background: transparent;
    clip: true;

    // Children retain the host's logical viewport, with no imposed padding,
    // scrolling, page creation or routing.
    if root.mode != NavigationContentSurfaceMode.transparent: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.navigation_content_bg;
        border-top-left-radius: root.mode == NavigationContentSurfaceMode.fluent ? root.corner_radius : 0px;
        border-top-right-radius: 0px;
        border-bottom-left-radius: 0px;
        border-bottom-right-radius: 0px;
    }

    // Path reserves half a stroke on each side before fitting its viewbox.
    // Match that reduced viewbox to avoid aspect-fit insets on wide surfaces.
    // Its automatic 0.5px offset centers our open frame on the first pixel.
    if root.mode == NavigationContentSurfaceMode.fluent && root.width > 1px && root.height > 1px: Path {
        width: 100%;
        height: 100%;
        viewbox-width: (root.width - 1px) / 1px;
        viewbox-height: (root.height - 1px) / 1px;
        fill: transparent;
        stroke: Theme.navigation_content_border;
        stroke-width: 1px;
        MoveTo { x: 0; y: root.height / 1px; }
        LineTo { x: 0; y: root.corner_radius / 1px - 0.5; }
        ArcTo {
            radius-x: root.corner_radius / 1px - 0.5;
            radius-y: root.corner_radius / 1px - 0.5;
            x: root.corner_radius / 1px - 0.5;
            y: 0;
            sweep: true;
        }
        LineTo { x: root.width / 1px; y: 0; }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        @children
    }
}
