import { Button, Palette } from "std-widgets.slint";
import { Theme, Typography } from "../../../foundation/theme.slint";
import { UiConstants } from "../../../foundation/constants.slint";
import { FluentIcons } from "../../../foundation/fluent_icons.slint";
import { FluentIcon } from "../../../primitives/fluent_icon.slint";
import { TooltipHost } from "../../../primitives/tooltip_host.slint";
import { NavigationEntry, NavigationEntryKind } from "../navigation_types.slint";

export component NavigationItemRow inherits Rectangle {
    in property <NavigationEntry> entry;
    in property <bool> presented;
    in property <bool> compact;
    in property <bool> selected;
    in property <string> context_label;
    in property <string> recovery_id;
    in property <int> recovery_epoch;
    callback invoked();
    callback expand();
    callback recover();
    callback navigate(int);
    callback focus_visible(length, length);
    private property <bool> interactive: root.entry.kind != NavigationEntryKind.header && root.entry.kind != NavigationEntryKind.separator;
    private property <bool> active: root.presented && root.entry.enabled && root.interactive;
    private property <bool> focus_memory: false;
    private property <length> inset: root.compact ? 2px : UiConstants.navigation_item_padding + root.entry.depth * UiConstants.navigation_item_indent;
    private property <length> arrow_width: root.entry.has_children ? (root.compact ? 22px : 32px) : 0px;
    visible: root.presented;
    height: !root.presented ? 0px : root.entry.kind == NavigationEntryKind.separator ? 9px : root.entry.kind == NavigationEntryKind.header ? (root.compact ? 0px : 28px) : UiConstants.navigation_item_height;
    vertical-stretch: 0;
    changed active => { if !root.active && root.focus_memory { root.focus_memory = false; root.recover(); } }
    if root.entry.kind == NavigationEntryKind.separator: Rectangle {
        x: 4px; y: 4px; width: max(0px, parent.width - 8px); height: 1px;
        background: Theme.navigation_content_border;
    }
    if root.entry.kind == NavigationEntryKind.header && !root.compact: Text {
        x: root.inset; width: max(0px, parent.width - root.inset - 4px); height: 100%;
        text: root.entry.text; color: Theme.text_secondary; font-size: Typography.caption;
        vertical-alignment: center; overflow: elide;
    }
    if root.interactive: FocusScope {
        width: 100%; height: 100%; enabled: root.active;
        focus-on-tab-navigation: false;
        private property <int> epoch: root.recovery_epoch;
        changed epoch => { if root.recovery_id == root.entry.id && root.active { command.focus(); } }
        capture-key-pressed(event) => { if root.active && root.direction(event.text) { return accept; } return reject; }
        command := Button {
            x: 0px; y: 0px;
            width: max(0px, parent.width - root.arrow_width); height: 100%;
            enabled: root.active; checkable: false; checked: root.selected;
            accessible-label: root.context_label;
            accessible-checkable: root.entry.kind == NavigationEntryKind.destination || root.entry.kind == NavigationEntryKind.destination_group;
            accessible-expandable: root.entry.kind == NavigationEntryKind.group && root.entry.has_children;
            accessible-expanded: root.entry.expanded;
            changed has-focus => {
                if self.has-focus { root.focus_memory = true; root.focus_visible(root.y, root.height); }
                else if root.active { root.focus_memory = false; }
            }
            clicked => {
                if root.active {
                    self.focus();
                    if root.entry.kind == NavigationEntryKind.group { if root.entry.has_children { root.expand(); } }
                    else { root.invoked(); }
                }
            }
        }
        FluentIcon {
            x: root.inset; y: (parent.height - self.height) / 2;
            size: UiConstants.navigation_icon_size;
            source: root.selected && root.entry.selected_icon.width > 0 ? root.entry.selected_icon : root.entry.icon.width > 0 ? root.entry.icon : root.compact ? FluentIcons.about_regular : root.entry.icon;
            icon_color: !root.entry.enabled ? Theme.text_disabled : root.selected ? Palette.accent-foreground : Palette.control-foreground;
        }
        if !root.compact: Text {
            x: root.inset + UiConstants.navigation_icon_slot_width + 8px;
            width: max(0px, parent.width - self.x - root.arrow_width - 4px); height: 100%;
            text: root.entry.text == "" ? root.entry.id : root.entry.text;
            color: !root.entry.enabled ? Theme.text_disabled : root.selected ? Palette.accent-foreground : Palette.control-foreground;
            font-size: Typography.body; font-weight: root.selected ? Typography.semibold : Typography.regular;
            vertical-alignment: center; overflow: elide; accessible-role: none;
        }
        if root.entry.has_children: Rectangle {
            x: parent.width - root.arrow_width; width: root.arrow_width; height: 100%;
            arrow := Button {
                width: 100%; height: 100%; enabled: root.active;
                accessible-label: (root.entry.expanded ? "Collapse " : "Expand ") + root.context_label;
                accessible-expandable: true; accessible-expanded: root.entry.expanded;
                changed has-focus => {
                    if self.has-focus { root.focus_memory = true; root.focus_visible(root.y, root.height); }
                    else if root.active { root.focus_memory = false; }
                }
                clicked => { if root.active { self.focus(); root.expand(); } }
            }
            Path {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
                commands: root.entry.expanded ? "M 4 6 L 8 10 L 12 6" : "M 6 4 L 10 8 L 6 12";
                fill: transparent; stroke: root.active ? Palette.control-foreground : Theme.text_disabled; stroke-width: 1px;
                stroke-line-cap: round; stroke-line-join: round; accessible-role: none;
            }
        }
    }
    Tooltip { TooltipHost { text: root.context_label; shown: true; } }
    function direction(key: string) -> bool {
        if key == Key.UpArrow { root.navigate(-1); return true; }
        if key == Key.DownArrow { root.navigate(1); return true; }
        if key == Key.Home { root.navigate(-2); return true; }
        if key == Key.End { root.navigate(2); return true; }
        if key == Key.RightArrow && root.entry.has_children { if !root.entry.expanded { root.expand(); } return true; }
        if key == Key.LeftArrow {
            if root.entry.has_children && root.entry.expanded { root.expand(); }
            else { root.recover(); }
            return true;
        }
        return false;
    }
}
