import { UiConstants } from "../../foundation/constants.slint";
import { FluentIcons } from "../../foundation/fluent_icons.slint";
import { Button } from "std-widgets.slint";
import { TooltipHost } from "../../primitives/tooltip_host.slint";
import { NavigationPaneMode } from "navigation_types.slint";

export component NavigationPaneToggleButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <NavigationPaneMode> pane_mode: NavigationPaneMode.expanded;
    in property <string> accessible_name: "Toggle navigation pane";
    callback clicked();

    width: UiConstants.navigation_item_height;
    height: UiConstants.navigation_item_height;
    forward-focus: button;
    accessible-role: none;

    button := Button {
        icon: FluentIcons.menu;
        colorize-icon: true;
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        accessible-label: root.accessible_name;
        accessible-expandable: true;
        accessible-expanded: root.pane_mode == NavigationPaneMode.expanded;
        clicked => { if (root.enabled) { button.focus(); root.clicked(); } }
    }

    // Popup tooltip stays readable at the left window edge and in compact panes.
    Tooltip { TooltipHost { text: root.accessible_name; shown: true; } }

}
