// Derived from wsl-dashboard src/ui/components/common.slint at
// 948589a255a4bd8a3ff9c3de49e2e13109378fcd. Font glyph icons were replaced by
// semantic SVG images.

import { IconButton } from "../../primitives/icon_button.slint";
import { UiConstants } from "../../foundation/constants.slint";

export component WindowControlButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> close_button: false;
    in property <bool> enabled: true;
    callback clicked;

    width: 46px;
    height: UiConstants.title_bar_height;
    forward-focus: command;
    command := IconButton {
        width: 100%; height: 100%;
        icon: root.icon;
        tooltip: root.label;
        accessible_name: root.label;
        danger: root.close_button;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
