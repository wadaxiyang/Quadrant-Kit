import { Palette } from "std-widgets.slint";
import { ModalManager, ModalKind, FluentButton, Theme, ThemeMode } from "@quadrant-kit";
export component ModalCheck inherits Window {
    width: 700px; height: 520px; default-font-family: "Segoe UI Variable Text";
    background: Theme.background;
    in-out property <bool> shown: false;
    in-out property <bool> secondary: true;
    in-out property <bool> dark: false;
    out property <int> restores: 0;
    out property <int> accepted_count: 0;
    out property <int> dismissed_count: 0;
    out property <int> background_count: 0;
    out property <bool> opener_focused: opener.has-focus;
    public function focus_opener() { opener.focus(); }
    init => { Theme.mode = ThemeMode.light; Palette.color-scheme = ColorScheme.light; }
    changed dark => { Theme.mode = root.dark ? ThemeMode.dark : ThemeMode.light; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    opener := FluentButton { x: 20px; y: 20px; width: 180px; height: 32px; text: "Open confirmation"; clicked => { root.background_count += 1; } }
    ModalManager { width: 100%; height: 100%; shown: root.shown;
        title: "Confirm test"; message: "No files are changed. Native buttons own confirmation.";
        show_secondary: root.secondary; danger_primary: true; kind: ModalKind.danger;
        primary_text: "Confirm"; secondary_text: "Cancel";
        restore_focus_requested => { root.restores += 1; opener.focus(); }
        accepted => { root.accepted_count += 1; }
        dismissed => { root.dismissed_count += 1; }
    }
}
