import { ToastHost, ModalManager, FluentButton, Theme, ThemeMode, Motion } from "@quadrant-kit";
import { Palette } from "std-widgets.slint";
export component MotionCheck inherits Window {
    width:1200px;height:600px;background:Theme.background;default-font-family:"Segoe UI Variable Text";
    in-out property <bool> toast_shown:false;
    in-out property <bool> modal_shown:false;
    in property <bool> batch_shown:false;
    in property <bool> toast_visible:true;
    in property <bool> modal_visible:true;
    in property <bool> motion_enabled:true;
    in property <bool> reduced:false;
    out property <bool> toast_presented:toast.presented;
    out property <bool> toast_animating:toast.animating;
    out property <bool> modal_presented:modal.presented;
    out property <bool> modal_animating:modal.animating;
    out property <int> batch_presented;
    out property <int> toast_dismissals;
    out property <int> modal_dismissals;
    out property <int> modal_accepts;
    out property <int> restores;
    out property <int> background_commands;
    out property <bool> opener_focused:opener.has-focus;
    public function focus_opener(){opener.focus();}
    init=>{Theme.mode=ThemeMode.light;Palette.color-scheme=ColorScheme.light;Motion.animations_enabled=root.motion_enabled;Motion.reduced_motion=root.reduced;}
    changed motion_enabled=>{Motion.animations_enabled=root.motion_enabled;}
    changed reduced=>{Motion.reduced_motion=root.reduced;}
    FluentButton{x:20px;y:20px;width:360px;height:56px;text:"Behind toast";clicked=>{root.background_commands+=1;}}
    opener:=FluentButton{x:400px;y:20px;width:180px;height:32px;text:"Restore focus";clicked=>{root.background_commands+=1;}}
    toast:=ToastHost{visible:root.toast_visible;x:20px;y:20px;width:360px;shown:root.toast_shown;auto_dismiss:false;message:"Cancelable opacity transition";dismissed=>{root.toast_dismissals+=1;}}
    for index in 20:ToastHost{x:12px+mod(index,4)*294px;y:160px+floor(index/4)*72px;width:280px;shown:root.batch_shown;auto_dismiss:false;message:"Batch transition";
        changed presented=>{root.batch_presented+=self.presented?1:-1;}
        dismissed=>{root.toast_dismissals+=1000;}
    }
    modal:=ModalManager{visible:root.modal_visible;width:100%;height:100%;shown:root.modal_shown;show_secondary:true;title:"Finite motion";message:"Native actions remain immediately available.";
        dismissed=>{root.modal_dismissals+=1;}
        accepted=>{root.modal_accepts+=1;}
        restore_focus_requested=>{root.restores+=1;opener.focus();}
    }
}
