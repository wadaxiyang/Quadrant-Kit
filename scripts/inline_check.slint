import { FluentExpander, FluentInfoBar, InfoBarKind } from "@quadrant-kit";
import { Button, Palette } from "std-widgets.slint";
export component InlineCheck inherits Window {
    width:700px;height:500px;background:#f3f3f3;
    in-out property <bool> expanded:false;
    in-out property <bool> info_shown:true;
    in property <bool> header_enabled:true;
    in property <bool> closable:true;
    in property <bool> adopt_requests:false;
    out property <int> expand_requests;
    out property <bool> requested_expanded;
    out property <bool> header_focused:expander.header_has_focus;
    out property <int> child_commands;
    out property <int> child_mounts;
    out property <int> child_ticks;
    out property <int> dismiss_requests;
    public function focus_header(){expander.focus_header();}
    expander:=FluentExpander{x:20px;y:20px;width:360px;text:"Details";expanded:root.expanded;header_enabled:root.header_enabled;
        expanded_requested(value)=>{root.expand_requests+=1;root.requested_expanded=value;if root.adopt_requests {root.expanded=value;}}
        if root.expanded: Rectangle{height:52px;init=>{root.child_mounts+=1;}
            Button{x:0px;y:0px;width:180px;height:32px;text:"Content command";clicked=>{root.child_commands+=1;}}
            Timer{running:true;interval:100ms;triggered=>{root.child_ticks+=1;}}
        }
    }
    FluentInfoBar{x:20px;y:220px;width:480px;height:80px;shown:root.info_shown;closable:root.closable;title:"Status";message:"Inline status message";kind:InfoBarKind.info;
        dismissed=>{root.dismiss_requests+=1;if root.adopt_requests {root.info_shown=false;}}
    }
}
