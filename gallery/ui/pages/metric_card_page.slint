import { GalleryPage } from "../shared/gallery_page.slint";
import { Specimen } from "../shared/specimen.slint";
import { MetricCard } from "@quadrant-kit";
export component MetricCardPage inherits GalleryPage {

    page_description: "Display a compact value with its label and supporting context.";
    Specimen {
        specimen_kind: "Reference";
        specimen_title: "Values and supporting text";
        specimen_description: "Display a compact value with its label and supporting context.";
        source_code: "import { MetricCard } from \"@quadrant-kit\";\nMetricCard { label: \"Items\"; value: \"18\"; hint: \"Available\"; }";
        keyboard_info: "Reference data is non-interactive.";
        accessibility_info: "Visible labels and state remain observable. Full screen-reader behavior is not yet verified.";
        MetricCard { label: "Items"; value: "18"; hint: "+4 from previous"; }
        MetricCard { label: "Collections"; value: "6"; hint: "Available groups"; }
    }
}
