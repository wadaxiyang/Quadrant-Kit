import { FluentIcon, FluentIcons, IconButton, Theme, Typography, UiConstants } from "@quadrant-kit";
import { GalleryPage } from "../shared/gallery_page.slint";
import { Specimen } from "../shared/specimen.slint";
import { StateSpecimen } from "../shared/state_specimen.slint";

component IconCatalogItem inherits VerticalLayout {
    in property <image> catalog_icon;
    in property <string> catalog_name;
    spacing: UiConstants.space_4;
    alignment: center;
    min-width: 88px;

    FluentIcon { source: root.catalog_icon; size: 20px; icon_color: Theme.icon_neutral; }
    Text { text: root.catalog_name; color: Theme.text_secondary; font-size: Typography.caption; horizontal-alignment: center; overflow: elide; }
}

export component IconsPage inherits GalleryPage {
    private property <int> action_count: 0;
    private property <string> last_action: "None";
    page_title: "Icons";
    page_description: "Vendored, cross-platform Microsoft Fluent SVG assets exposed through semantic public names.";
    page_source: "import { FluentIcon, FluentIcons } from \"@quadrant-kit\";\n\nFluentIcon { source: FluentIcons.calendar; size: 16px; }";

    Specimen {
        specimen_title: "IconButton states";
        source_code: "import { IconButton, FluentIcons } from \"@quadrant-kit\";\n\nIconButton { icon: FluentIcons.add; tooltip: \"Add\"; clicked => { /* Handle the action in the host. */ } }";
        specimen_description: "Activate an icon to update the action count. The disabled icon must leave it unchanged.";
        specimen_kind: "States";
        keyboard_info: "Tab focuses; Enter or Space invokes the default action.";
        accessibility_info: "Role button; tooltip supplies the accessible label; enabled state is exposed.";

        GridLayout {
            spacing: UiConstants.space_12;
            Row {
                StateSpecimen { label: "Normal"; IconButton { icon: FluentIcons.add; tooltip: "Add"; clicked => { root.action_count += 1; root.last_action = "Add"; } } }
                StateSpecimen { label: "Hover"; IconButton { icon: FluentIcons.add; tooltip: "Add"; preview_hover: true; clicked => { root.action_count += 1; root.last_action = "Hover sample"; } } }
                StateSpecimen { label: "Pressed"; IconButton { icon: FluentIcons.add; tooltip: "Add"; preview_pressed: true; clicked => { root.action_count += 1; root.last_action = "Pressed sample"; } } }
            }
            Row {
                StateSpecimen { label: "Keyboard focus"; IconButton { icon: FluentIcons.add; tooltip: "Add"; preview_focus: true; clicked => { root.action_count += 1; root.last_action = "Focus sample"; } } }
                StateSpecimen { label: "Danger"; IconButton { icon: FluentIcons.delete; tooltip: "Delete"; danger: true; preview_hover: true; clicked => { root.action_count += 1; root.last_action = "Delete"; } } }
                StateSpecimen { label: "Disabled"; IconButton { icon: FluentIcons.dismiss; tooltip: "Dismiss"; enabled: false; clicked => { root.action_count += 1; root.last_action = "Disabled sample"; } } }
            }
        }
        Text {
            text: "Icon actions: " + root.action_count + " · Last: " + root.last_action;
            color: Theme.text_secondary;
            font-size: Typography.body;
            wrap: word-wrap;
        }
    }

    Specimen {
        specimen_title: "Semantic icon catalog";
        source_code: "import { FluentIcon, FluentIcons } from \"@quadrant-kit\";\n\nFluentIcon { source: FluentIcons.calendar; size: 20px; }";
        specimen_description: "Regular/Filled navigation, 16px actions, and 24px status icons remain distinct assets.";
        specimen_kind: "Catalog";
        keyboard_info: "Not applicable; catalog glyphs are reference content.";
        accessibility_info: "Decorative FluentIcon hosts are paired with visible semantic names.";

        VerticalLayout {
            spacing: UiConstants.space_12;
            HorizontalLayout {
                IconCatalogItem { catalog_icon: FluentIcons.settings_regular; catalog_name: "settings"; }
                IconCatalogItem { catalog_icon: FluentIcons.about_regular; catalog_name: "about"; }
                IconCatalogItem { catalog_icon: FluentIcons.settings_filled; catalog_name: "settings filled"; }
                IconCatalogItem { catalog_icon: FluentIcons.about_filled; catalog_name: "about filled"; }
                IconCatalogItem { catalog_icon: FluentIcons.menu; catalog_name: "menu"; }
            }
            HorizontalLayout {
                IconCatalogItem { catalog_icon: FluentIcons.add; catalog_name: "add"; }
                IconCatalogItem { catalog_icon: FluentIcons.dismiss; catalog_name: "dismiss"; }
                IconCatalogItem { catalog_icon: FluentIcons.minimize; catalog_name: "minimize"; }
                IconCatalogItem { catalog_icon: FluentIcons.maximize; catalog_name: "maximize"; }
                IconCatalogItem { catalog_icon: FluentIcons.restore_window; catalog_name: "window restore"; }
            }
            HorizontalLayout {
                IconCatalogItem { catalog_icon: FluentIcons.edit; catalog_name: "edit"; }
                IconCatalogItem { catalog_icon: FluentIcons.delete; catalog_name: "delete"; }
                IconCatalogItem { catalog_icon: FluentIcons.complete; catalog_name: "complete"; }
                IconCatalogItem { catalog_icon: FluentIcons.more_horizontal; catalog_name: "more"; }
            }
            HorizontalLayout {
                IconCatalogItem { catalog_icon: FluentIcons.calendar; catalog_name: "calendar"; }
                IconCatalogItem { catalog_icon: FluentIcons.clock; catalog_name: "clock"; }
                IconCatalogItem { catalog_icon: FluentIcons.recurrence; catalog_name: "recurrence"; }
                IconCatalogItem { catalog_icon: FluentIcons.folder_open; catalog_name: "folder"; }
                IconCatalogItem { catalog_icon: FluentIcons.backup; catalog_name: "backup"; }
            }
            HorizontalLayout {
                IconCatalogItem { catalog_icon: FluentIcons.theme_system; catalog_name: "theme system"; }
                IconCatalogItem { catalog_icon: FluentIcons.theme_light; catalog_name: "theme light"; }
                IconCatalogItem { catalog_icon: FluentIcons.theme_dark; catalog_name: "theme dark"; }
                IconCatalogItem { catalog_icon: FluentIcons.chevron_up; catalog_name: "chevron up"; }
                IconCatalogItem { catalog_icon: FluentIcons.chevron_down; catalog_name: "chevron down"; }
            }
            HorizontalLayout {
                IconCatalogItem { catalog_icon: FluentIcons.info; catalog_name: "info action"; }
                IconCatalogItem { catalog_icon: FluentIcons.warning; catalog_name: "warning action"; }
                IconCatalogItem { catalog_icon: FluentIcons.error; catalog_name: "error action"; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                IconCatalogItem { catalog_icon: FluentIcons.status_info; catalog_name: "info"; }
                IconCatalogItem { catalog_icon: FluentIcons.status_success; catalog_name: "success"; }
                IconCatalogItem { catalog_icon: FluentIcons.status_warning; catalog_name: "warning"; }
                IconCatalogItem { catalog_icon: FluentIcons.status_error; catalog_name: "error"; }
                IconCatalogItem { catalog_icon: FluentIcons.heart_filled; catalog_name: "heart"; }
            }
        }
    }

}
