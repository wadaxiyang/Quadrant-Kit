import { Switch } from "std-widgets.slint";
import { EmptyState, FluentIcons, IconButton, MetricCard, PageHeader, SidebarItem, Theme, Typography, UiConstants, WindowControlButton } from "@quadrant-kit";
import { GalleryPage } from "../shared/gallery_page.slint";
import { Specimen } from "../shared/specimen.slint";
import { PropertyPanel } from "../shared/property_panel.slint";
import { CodeSample } from "../shared/code_sample.slint";
import { PreviewContainer } from "../shared/preview_container.slint";

export component NavigationPage inherits GalleryPage {
    in property <int> preview_mode: 1;
    private property <bool> sidebar_selected: true;
    private property <bool> sidebar_collapsed: false;
    private property <int> header_actions: 0;
    private property <int> window_actions: 0;
    private property <string> last_window_action: "None";

    page_title: "Navigation & shell";
    page_description: "Reusable navigation, page framing, window controls, empty states, and generic application framing.";

    Specimen {
        specimen_title: "SidebarItem · interactive";
        specimen_description: "The same 40px navigation pattern supports selected and collapsed states without importing the Product Sidebar.";
        keyboard_info: "Tab focuses; Enter or Space invokes clicked on the first activation.";
        accessibility_info: "Role button with label, checkable, and checked state; collapsed hover exposes a tooltip.";

        PreviewContainer {
            preview_mode: root.preview_mode;
            preview_title: "Navigation width boundary";
            SidebarItem {
                width: root.sidebar_collapsed ? UiConstants.sidebar_collapsed_width : min(parent.width, UiConstants.sidebar_expanded_width);
                icon: FluentIcons.settings_regular;
                selected_icon: FluentIcons.settings_filled;
                text: "Preferences";
                selected: root.sidebar_selected;
                collapsed: root.sidebar_collapsed;
                clicked => { root.sidebar_selected = !root.sidebar_selected; }
            }
        }

        PropertyPanel {
            HorizontalLayout {
                spacing: UiConstants.space_16;
                Switch { text: "Selected"; checked <=> root.sidebar_selected; }
                Switch { text: "Collapsed"; checked <=> root.sidebar_collapsed; }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    Specimen {
        specimen_title: "PageHeader and EmptyState";
        specimen_description: "Both patterns derive height from their content and remain valid in Compact, Medium, and Wide containers.";
        specimen_kind: "Interactive";
        keyboard_info: "PageHeader action follows FluentButton keyboard behavior; EmptyState is not interactive.";
        accessibility_info: "The action is labeled; empty-state meaning is carried by visible title and message, not icon alone.";

        PreviewContainer {
            preview_mode: root.preview_mode;
            preview_title: "Page surface preview";
            PageHeader {
                title: "Preferences";
                subtitle: "Configure the workspace display and interaction preferences.";
                show_action: true;
                action_text: "Add item";
                action_clicked => { root.header_actions += 1; }
            }
            Text {
                text: "Add item actions: " + root.header_actions;
                color: Theme.text_secondary;
                font-size: Typography.body;
                wrap: word-wrap;
            }
            GridLayout {
                spacing: UiConstants.space_8;
                Row {
                    MetricCard { label: "Items"; value: "18"; hint: "+4 from previous"; }
                    MetricCard { label: "Collections"; value: "6"; hint: "Available groups"; }
                }
            }
            EmptyState {
                title: "No items yet";
                message: "Items added to this collection will appear here.";
                icon: FluentIcons.status_info;
            }
        }
    }

    Specimen {
        specimen_title: "Window controls";
        specimen_description: "Actions update the result below. The Gallery window stays open so each action can be tested repeatedly.";
        specimen_kind: "Interactive";
        keyboard_info: "Tab focuses; Enter or Space records each window action.";
        accessibility_info: "Every action exposes button role and Minimize, Maximize, or Close label.";

        HorizontalLayout {
            height: 40px;
            spacing: 0px;
            WindowControlButton { icon: FluentIcons.minimize; label: "Minimize"; clicked => { root.window_actions += 1; root.last_window_action = "Minimize"; } }
            WindowControlButton { icon: FluentIcons.maximize; label: "Maximize"; clicked => { root.window_actions += 1; root.last_window_action = "Maximize"; } }
            WindowControlButton { icon: FluentIcons.dismiss; label: "Close"; close_button: true; clicked => { root.window_actions += 1; root.last_window_action = "Close"; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: "Window actions: " + root.window_actions + " · Last: " + root.last_window_action;
            color: Theme.text_secondary;
            font-size: Typography.body;
            wrap: word-wrap;
        }
    }

    CodeSample {
        code: "import { PageHeader, SidebarItem } from \"@quadrant-kit\";\n\nSidebarItem { text: \"Preferences\"; selected: true; clicked => { navigate(); } }";
    }
}
