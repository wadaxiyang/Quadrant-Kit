import { GalleryPage } from "../shared/gallery_page.slint";
import { Specimen } from "../shared/specimen.slint";
import { EmptyState, FluentIcons } from "@quadrant-kit";
export component EmptyStatePage inherits GalleryPage {

    page_description: "An empty state communicates meaning with a title, message and optional icon.";
    Specimen {
        specimen_title: "No content yet";
        specimen_description: "An empty state communicates meaning with a title, message and optional icon.";
        source_code: "import { EmptyState } from \"@quadrant-kit\";\nEmptyState { title: \"No items yet\"; message: \"New items appear here.\"; }";
        keyboard_info: "This informational state is non-interactive.";
        accessibility_info: "Visible labels and state remain observable. Full screen-reader behavior is not yet verified.";
        EmptyState { title: "No items yet"; message: "Items added to this collection will appear here."; icon: FluentIcons.status_info; }
    }
}
