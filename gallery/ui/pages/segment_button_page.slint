import { GalleryPage } from "../shared/gallery_page.slint";
import { Specimen } from "../shared/specimen.slint";
import { SegmentButton, Theme } from "@quadrant-kit";
export component SegmentButtonPage inherits GalleryPage {
    private property <int> choice: 0;
    page_description: "Choose a segment and observe the host-owned selection.";
    Specimen {
        specimen_title: "Selection and disabled state";
        specimen_description: "Choose a segment and observe the host-owned selection.";
        source_code: "import { SegmentButton } from \"@quadrant-kit\";\nSegmentButton { text: \"Recent\"; selected: true; }";
        keyboard_info: "Tab focuses interactive controls; Enter or Space invokes actions. Standard editors use platform editing keys.";
        accessibility_info: "Visible labels and state remain observable. Full screen-reader behavior is not yet verified.";
        HorizontalLayout {
            SegmentButton { text: "All"; selected: root.choice == 0; clicked => { root.choice = 0; } }
            SegmentButton { text: "Recent"; selected: root.choice == 1; clicked => { root.choice = 1; } }
            SegmentButton { text: "Disabled"; enabled: false; }
        }
        Text { text: root.choice == 0 ? "Selected: All" : "Selected: Recent"; color: Theme.text_primary; }
    }
}
