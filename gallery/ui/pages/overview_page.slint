import { Badge, BadgeKind, FluentIcons, FluentIcon, SurfaceCard, Theme, Typography, UiConstants } from "@quadrant-kit";
import { GalleryPage } from "../shared/gallery_page.slint";
import { Specimen } from "../shared/specimen.slint";

component OverviewTile inherits SurfaceCard {
    in property <image> tile_icon;
    in property <string> tile_title;
    in property <string> tile_description;
    in property <string> tile_count;
    preferred-height: tile_layout.preferred-height;

    tile_layout := VerticalLayout {
        padding: UiConstants.space_12;
        spacing: UiConstants.space_8;

        HorizontalLayout {
            spacing: UiConstants.space_8;
            FluentIcon { source: root.tile_icon; size: 20px; icon_color: Theme.accent; }
            Text {
                horizontal-stretch: 1;
                text: root.tile_title;
                color: Theme.text_primary;
                font-size: Typography.body;
                font-weight: Typography.semibold;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            Badge { text: root.tile_count; kind: BadgeKind.accent; }
        }

        Text {
            text: root.tile_description;
            color: Theme.text_secondary;
            font-size: Typography.caption;
            wrap: word-wrap;
        }
    }
}

export component OverviewPage inherits GalleryPage {
    page_title: "Overview";
    page_description: "A development-only catalog for choosing, exercising, and integrating the shared Fluent UI Kit.";
    page_source: "import { FluentButton, Theme } from \"@quadrant-kit\";\n\nFluentButton { text: \"Save\"; primary: true; }";

    Specimen {
        specimen_title: "Catalog map";
        source_code: "import { SurfaceCard, Badge } from \"@quadrant-kit\";\n\nSurfaceCard { Badge { text: \"Candidate\"; } }";
        specimen_description: "Eight pages demonstrate the 35 public exports across Foundation, Controls, Surfaces, Feedback, and Navigation.";
        specimen_kind: "Overview";
        keyboard_info: "Tab through the navigation pane; Enter or Space opens a page.";
        accessibility_info: "Navigation entries expose button role, selected state, and stable labels.";

        // The 304 px navigation pane leaves a narrow content host at 760 px.
        // Stack tiles there instead of letting the grid's minimum width overflow.
        if root.width < 600px: VerticalLayout {
            spacing: UiConstants.space_12;
            OverviewTile { tile_icon: FluentIcons.info; tile_title: "Foundation"; tile_description: "Tokens, type, motion, elevation, and semantic icons."; tile_count: "4 pages"; }
            OverviewTile { tile_icon: FluentIcons.add; tile_title: "Controls"; tile_description: "Buttons, fields, selection, Switch, badge, and tooltip states."; tile_count: "1 page"; }
            OverviewTile { tile_icon: FluentIcons.menu; tile_title: "Surfaces & feedback"; tile_description: "Cards, empty states, modal decisions, and transient toast messages."; tile_count: "2 pages"; }
            OverviewTile { tile_icon: FluentIcons.menu; tile_title: "Navigation"; tile_description: "Back, pane toggle, content surfaces, NavigationView, page headers, and window controls."; tile_count: "1 page"; }
        }
        if root.width >= 600px: GridLayout {
            spacing: UiConstants.space_12;
            Row {
                OverviewTile { tile_icon: FluentIcons.info; tile_title: "Foundation"; tile_description: "Tokens, type, motion, elevation, and semantic icons."; tile_count: "4 pages"; }
                OverviewTile { tile_icon: FluentIcons.add; tile_title: "Controls"; tile_description: "Buttons, fields, selection, Switch, badge, and tooltip states."; tile_count: "1 page"; }
            }
            Row {
                OverviewTile { tile_icon: FluentIcons.menu; tile_title: "Surfaces & feedback"; tile_description: "Cards, empty states, modal decisions, and transient toast messages."; tile_count: "2 pages"; }
                OverviewTile { tile_icon: FluentIcons.menu; tile_title: "Navigation"; tile_description: "Back, pane toggle, content surfaces, NavigationView, page headers, and window controls."; tile_count: "1 page"; }
            }
        }
    }

    Specimen {
        specimen_title: "Using this tool";
        source_code: "import { FluentButton } from \"@quadrant-kit\";\n\nFluentButton { text: \"Try an action\"; primary: true; }";
        specimen_description: "Choose a page, set theme and preview width, adjust live properties, then verify interaction and usage guidance together.";
        specimen_kind: "Workflow";
        keyboard_info: "All controls participate in normal Tab order; component-specific keys are listed in each specimen.";
        accessibility_info: "Every interactive specimen documents its exposed role, label, enabled, checked, or selected state.";

        Text {
            text: "1  Open a page   ·   2  Set theme and preview   ·   3  Change live properties   ·   4  Inspect states, keyboard behavior, accessibility, and code";
            color: Theme.text_primary;
            font-size: Typography.body;
            wrap: word-wrap;
        }
    }

}
