import { FluentButton, FluentTextField } from "@quadrant-kit";
import { GalleryPage } from "../shared/gallery_page.slint";

import { ButtonInteractiveSpecimen } from "../shared/button_interactive_specimen.slint";

import { ButtonStatesSpecimen } from "../shared/button_states_specimen.slint";

import { TextEditorsSpecimen } from "../shared/text_editors_specimen.slint";

import { SelectionSpecimen } from "../shared/selection_specimen.slint";

export component ControlsPage inherits GalleryPage {

    in property <int> preview_mode: 1;
    in-out property <string> sample_text: "Prepare a sample document";
    in-out property <bool> sample_switch: true;

    page_description: "Interactive input and command primitives with deterministic state, variant, content-boundary, keyboard, and accessibility coverage.";
    page_source: "import { FluentButton, FluentTextField } from \"@quadrant-kit\";\n\nFluentTextField { text <=> title; placeholder_text: \"Task title\"; }\nFluentButton { text: \"Save\"; primary: true; clicked => { save(); } }";

    ButtonInteractiveSpecimen { preview_mode: root.preview_mode; sample_text <=> root.sample_text; sample_switch <=> root.sample_switch; }

    ButtonStatesSpecimen { preview_mode: root.preview_mode; sample_text <=> root.sample_text; sample_switch <=> root.sample_switch; }

    TextEditorsSpecimen { preview_mode: root.preview_mode; sample_text <=> root.sample_text; sample_switch <=> root.sample_switch; }

    SelectionSpecimen { preview_mode: root.preview_mode; sample_text <=> root.sample_text; sample_switch <=> root.sample_switch; }

}
