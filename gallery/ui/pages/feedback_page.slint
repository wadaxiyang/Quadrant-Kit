import { ToastHost, ToastKind } from "@quadrant-kit";
import { GalleryPage } from "../shared/gallery_page.slint";

import { ToastInteractiveSpecimen } from "../shared/toast_interactive_specimen.slint";

import { ToastBoundariesSpecimen } from "../shared/toast_boundaries_specimen.slint";

import { ModalDecisionsSpecimen } from "../shared/modal_decisions_specimen.slint";

export component FeedbackPage inherits GalleryPage {

    in property <int> preview_mode: 1;
    in property <int> restore_epoch;
    callback modal_requested(int);

    page_description: "Toast communicates transient outcomes; Modal owns focused decisions that require explicit acceptance or dismissal.";
    page_source: "import { ModalManager, ToastHost, ToastKind } from \"@quadrant-kit\";\n\nToastHost { shown: true; kind: ToastKind.success; message: \"Saved\"; }";

    ToastInteractiveSpecimen { preview_mode: root.preview_mode; modal_requested(kind) => { root.modal_requested(kind); } }

    ToastBoundariesSpecimen { preview_mode: root.preview_mode; modal_requested(kind) => { root.modal_requested(kind); } }

    ModalDecisionsSpecimen { restore_epoch: root.restore_epoch; preview_mode: root.preview_mode; modal_requested(kind) => { root.modal_requested(kind); } }

}
