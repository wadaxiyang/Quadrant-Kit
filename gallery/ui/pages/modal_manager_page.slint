import { GalleryPage } from "../shared/gallery_page.slint";
import { ModalDecisionsSpecimen } from "../shared/modal_decisions_specimen.slint";
export component ModalManagerPage inherits GalleryPage {
    in property <int> restore_epoch;
    callback modal_requested(int);
    page_description: "Host-controlled informational, warning and destructive confirmations.";
    ModalDecisionsSpecimen { restore_epoch: root.restore_epoch; modal_requested(kind) => { root.modal_requested(kind); } }
}
