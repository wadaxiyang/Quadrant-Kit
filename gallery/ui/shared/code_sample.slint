import { TextEdit } from "std-widgets.slint";
import { Theme, Typography, UiConstants } from "@quadrant-kit";

// A component-local editor viewport; this is not a page-level scroll host.
export component CodeSample inherits Rectangle {
    in property <string> code;
    in property <string> caption: "Illustrative Slint source";
    preferred-height: code_layout.preferred-height;
    vertical-stretch: 0;
    min-width: 0px;
    background: transparent;
    code_layout := VerticalLayout {
        spacing: UiConstants.space_8;
        Text { text: root.caption; color: Theme.text_tertiary; font-size: Typography.caption; wrap: word-wrap; }
        TextEdit {
            height: 180px; min-width: 0px;
            text: root.code; read-only: true; wrap: word-wrap;
            font-family: "monospace"; font-size: Typography.caption;
            accessible-label: root.caption;
        }
    }
}
