import { NavigationBackButton } from "@quadrant-kit";

// Gallery window composition, not a public Kit title-bar or navigation API.
export component GalleryToolbar inherits Rectangle {
    in property <length> leading_inset;
    in property <length> trailing_inset;
    // Host mirrors the actual native minimize button in logical client coordinates.
    in property <length> back_width: 46px;
    in property <length> back_height: 30px;
    in property <length> back_top: 1px;
    in property <bool> back_enabled;
    in property <bool> client_caption_input;
    callback caption_pressed();
    callback back_requested();
    out property <length> drag_x: title_region.x;
    out property <length> drag_width: title_region.width;
    height: 32px;
    min-width: 0px;
    NavigationBackButton {
        x: root.leading_inset + 4px; y: root.back_top;
        width: root.back_width; height: root.back_height;
        enabled: root.back_enabled;
        clicked => { root.back_requested(); }
    }
    title_region := Rectangle {
        x: root.leading_inset + 4px + root.back_width;
        width: max(0px, parent.width - self.x - root.trailing_inset); height: 100%;
        TouchArea {
            enabled: root.client_caption_input;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.caption_pressed(); }
            }
        }
    }
}
