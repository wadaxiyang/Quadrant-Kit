import { Badge, BadgeKind, SurfaceCard, Theme, Typography, UiConstants } from "@quadrant-kit";
import { SpecimenSourcePanel } from "specimen_source_panel.slint";

export component Specimen inherits SurfaceCard {
    in property <string> specimen_title;
    in property <string> specimen_description;
    in property <string> specimen_kind: "Interactive";
    in property <string> source_code;
    in property <string> keyboard_info: "Not applicable";
    in property <string> accessibility_info: "No interactive semantics";
    preferred-height: specimen_layout.preferred-height;
    vertical-stretch: 0; min-width: 0px;
    specimen_layout := VerticalLayout {
        spacing: 0px; padding: 1px;
        VerticalLayout {
            padding: UiConstants.space_16; spacing: UiConstants.space_16;
            VerticalLayout {
                spacing: UiConstants.space_8;
                HorizontalLayout {
                    spacing: UiConstants.space_12;
                    Text { text: root.specimen_title; color: Theme.text_primary; font-size: 16px; font-weight: Typography.semibold; wrap: word-wrap; horizontal-stretch: 1; }
                    if root.specimen_kind != "": Badge { text: root.specimen_kind; kind: root.specimen_kind == "Interactive" ? BadgeKind.accent : BadgeKind.neutral; }
                }
                if root.specimen_description != "": Text { text: root.specimen_description; color: Theme.text_secondary; font-size: Typography.caption; wrap: word-wrap; }
            }
            @children
        }
        SpecimenSourcePanel {
            title: root.specimen_title; source_code: root.source_code;
            keyboard_info: root.keyboard_info; accessibility_info: root.accessibility_info;
        }
    }
}
