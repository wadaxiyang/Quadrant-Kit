import { NavigationEntry, FluentIcons } from "@quadrant-kit";

// Application state is supplied by gallery/src/navigation.rs, never by Kit.
export global GalleryNavigation {
    in-out property <[NavigationEntry]> items;
    in-out property <string> selected_id: "overview";
    in-out property <int> page: 0;
    in-out property <bool> can_go_back: false;
    in-out property <string> query;
    in-out property <string> search_status;
    // Icons remain facade-supplied assets in the consumer's Slint compilation.
    out property <[image]> icons: [FluentIcons.about_regular, FluentIcons.theme_system, FluentIcons.edit, FluentIcons.info, FluentIcons.add, FluentIcons.menu, FluentIcons.status_info, FluentIcons.menu];
    out property <[image]> selected_icons: [FluentIcons.about_filled, FluentIcons.theme_system, FluentIcons.edit, FluentIcons.info, FluentIcons.add, FluentIcons.menu, FluentIcons.status_success, FluentIcons.menu];
    callback navigate(string);
    callback back_requested();
    callback query_edited(string);
    callback search_submitted(string);
    callback expansion_requested(string, bool);
}
