import { FluentExpander, FluentInfoBar, InfoBarKind } from "@quadrant-kit";
import { FluentFlyout, FluentDropDownButton, FluentSplitButton } from "@quadrant-kit";
// SPDX-FileCopyrightText: Copyright (c) 2026 Quadrant contributors
// SPDX-License-Identifier: GPL-3.0-only
import {
    FluentCheckBox, FluentSwitch, FluentRadioGroup, FluentComboBox,
    FluentSlider, FluentSpinBox, FluentProgressBar, FluentProgressRing,
    FluentScrollView, FluentListView, FluentStandardListView, FluentGroupBox, FluentTabWidget,
    FluentStandardTableView, FluentDatePicker, FluentTimePicker, Date, Time,
    Elevation, Motion, Theme, ThemeMode, Typography, UiConstants, FluentIcons,
    FluentIcon, TooltipHost, SurfaceCard, Badge, BadgeKind, FluentButton, IconButton,
    SegmentButton, FluentTextField, FluentTextArea, SettingRow,
    WindowControlButton, SectionHeader, PageHeader, EmptyState, MetricCard,
    ToastHost, ToastKind, ModalManager, ModalKind,
    NavigationPaneMode, NavigationContentSurfaceMode, NavigationEntryKind, NavigationEntry,
    NavigationBackButton, NavigationPaneToggleButton, NavigationContentSurface, NavigationView,
} from "@quadrant-kit";

// Compiled through gallery.slint; normal Gallery startup does not instantiate it.
export component KitApiProbe inherits Window {
    out property <bool> kit_motion_enabled: Motion.animations_enabled && !Motion.reduced_motion;
    width: 760px;
    height: 800px;
    in-out property <bool> controls_enabled: true;
    in-out property <string> selection: "preferences";
    callback navigation_requested(string);
    out property <bool> command_focused: command.has-focus;
    out property <bool> command_pressed: command.pressed;
    public function focus-command() { command.focus(); }
    public function focus-editor() { editor.focus(); }
    public function apply-host-state() {
        Theme.mode = root.mode;
        root.selection = "preferences";
        root.activated = false;
        root.sample_text = "程序赋值 / host update";
    }
    in-out property <string> sample_text: "Sample";
    in-out property <bool> activated: false;
    in-out property <ThemeMode> mode: ThemeMode.system;
    out property <duration> motion_duration: Motion.fast;
    in-out property <NavigationPaneMode> pane_mode: NavigationPaneMode.expanded;
    out property <[NavigationEntry]> navigation_entries: [
        { id: "preferences", parent_id: "", depth: 0, text: "Preferences",
          icon: FluentIcons.settings_regular, selected_icon: FluentIcons.settings_filled,
          kind: NavigationEntryKind.destination, enabled: true, has_children: false, expanded: false },
    ];
    background: Elevation.card_surface;
    default-font-size: Typography.body;
    default-font-family: Theme.ui_font_family;
    private property <Date> selected_date: { year: 2026, month: 9, day: 10 };
    private property <Time> selected_time: { hour: 12, minute: 30, second: 0 };
    probe_flyout := FluentFlyout { FluentButton {text:"Close";clicked=>{probe_flyout.close();}} }
    VerticalLayout {
        FluentStandardTableView { height: 200px; columns: [{ title: "Name", width: 160px }]; rows: [[{ text: "One" }]]; }
        FluentDatePicker { date: root.selected_date; accepted(value) => { root.selected_date = value; } }
        FluentTimePicker { time: root.selected_time; accepted(value) => { root.selected_time = value; } }

        FluentScrollView { height: 80px; viewport-height: 200px; Text { text: "Scroll content"; } }
        FluentListView { height: 80px; for index in 10000: Text { text: index; height: 24px; } }
        FluentStandardListView { height: 80px; model: [{ text: "One" }]; current-item: 0; scrollbars-enabled: true; }
        FluentGroupBox { title: "Group"; enabled: root.controls_enabled; FluentSwitch { text: "Child"; enabled: root.controls_enabled; } }
        FluentTabWidget { height: 100px; current-index: 0; Tab { title: "One"; Text { text: "One"; } } Tab { title: "Two"; Text { text: "Two"; } } }

        FluentSlider { value: 20; minimum: 0; maximum: 100; step: 5; enabled: root.controls_enabled; }
        FluentDropDownButton { text:"More"; FluentButton {text:"Option";} }
        FluentSplitButton { text:"Apply"; clicked=>{root.activated=true;} FluentButton {text:"Alternative";} }
        FluentExpander { text:"Details"; expanded:root.activated; expanded_requested(value)=>{root.activated=value;} if root.activated: FluentButton {text:"Slot";} }
        FluentInfoBar { shown:root.activated; title:"Status"; message:"Message"; kind:InfoBarKind.warning; dismissed=>{root.activated=false;} }
        FluentSpinBox { value: 12; read-only: true; step-size: 2; }
        FluentProgressBar { progress: 0.5; running: false; indeterminate: true; }
        FluentProgressRing { progress: 0.5; running: false; }
        FluentCheckBox { text: "Check"; checked <=> root.activated; enabled: root.controls_enabled; }
        FluentSwitch { text: "Switch"; checked <=> root.activated; enabled: root.controls_enabled; }
        FluentRadioGroup { title: "Options"; RadioButton { text: "One"; checked: true; } RadioButton { text: "Two"; } }
        FluentComboBox { model: ["One", "Two"]; current-index: 1; }
        spacing: UiConstants.space_8;
        FluentIcon { source: FluentIcons.menu; icon_color: Theme.accent; }
        TooltipHost { shown: false; text: "Help"; }
        SurfaceCard { interactive: true; accessible_name: "Sample"; clicked => { root.activated = true; } Text { text: "Card child"; } }
        Badge { text: "Sample"; kind: BadgeKind.accent; }
        command := FluentButton { text: "Apply"; icon: FluentIcons.add; enabled: root.controls_enabled; primary: true; clicked => { root.activated = true; } }
        IconButton { icon: FluentIcons.add; tooltip: "Add"; accessible_name: "Create item"; enabled: root.controls_enabled; clicked => { root.activated = true; } }
        SegmentButton { text: "Select"; accessible_name: "Select preference"; enabled: root.controls_enabled; selected: root.activated; clicked => { root.activated = !root.activated; } }
        editor := FluentTextField { width: 160px; enabled: root.controls_enabled; text <=> root.sample_text; accepted(value) => { root.sample_text = value; } edited(value) => { root.sample_text = value; } }
        FluentTextArea { text <=> root.sample_text; edited(value) => { root.sample_text = value; } }
        SettingRow { title: "Preference"; description: "Sample"; enabled: root.controls_enabled;
            FluentButton { text: "Slot command"; enabled: root.controls_enabled; }
        }
        NavigationBackButton { accessible_name: "Go back"; enabled: root.activated; clicked => { root.activated = false; } }
        NavigationView { init => { if !self.model_valid { root.activated = false; } }
            height: 100px; items: root.navigation_entries; selected_id: root.selection;
            pane_mode: root.pane_mode;
            item_invoked(id) => { root.navigation_requested(id); }
            Text { text: "Host content"; }
        }
        NavigationPaneToggleButton {
            pane_mode: root.pane_mode;
            clicked => { root.pane_mode = root.pane_mode == NavigationPaneMode.expanded ? NavigationPaneMode.compact : NavigationPaneMode.expanded; }
        }
        NavigationContentSurface {
            mode: NavigationContentSurfaceMode.fluent;
            height: 40px;
            Text { text: root.navigation_entries[0].text; color: Theme.text_primary; }
        }
        WindowControlButton { icon: FluentIcons.dismiss; label: "Close"; enabled: root.controls_enabled; clicked => { root.activated = false; } }
        SectionHeader { title: "Section"; badge_text: "New"; badge_kind: BadgeKind.neutral; Text { text: "Trailing content"; } }
        PageHeader { title: "Page"; show_action: true; action_text: "Add"; action_clicked => { root.activated = true; } }
        EmptyState { title: "Empty"; message: "No items"; }
        MetricCard { label: "Items"; value: "0"; hint: "Sample"; }
        ToastHost { init=>{if self.presented || self.animating {root.activated=false;}} shown: false; kind: ToastKind.info; message: "Saved"; dismissed => { root.activated = false; } }
        ModalManager { init=>{if self.presented || self.animating {root.activated=false;}} restore_focus_requested => { } shown: false; kind: ModalKind.warning; title: "Apply?"; accepted => { root.activated = true; } dismissed => { root.activated = false; } }
    }
}
