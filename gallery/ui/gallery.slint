import { Palette } from "std-widgets.slint";
import { ModalKind, ModalManager, NavigationView, NavigationPaneMode, Theme, ThemeMode, Typography, SegmentButton, UiConstants } from "@quadrant-kit";
import { GalleryTitleBar } from "shared/gallery_title_bar.slint";
import { GalleryNavigation } from "shared/gallery_catalog.slint";
import { HomePage } from "pages/home_page.slint";
import { AllComponentsPage } from "pages/all_components_page.slint";
import { TokensPage } from "pages/tokens_page.slint";
import { TypographyPage } from "pages/typography_page.slint";
import { IconsPage } from "pages/icons_page.slint";
import { ControlsPage } from "pages/controls_page.slint";
import { FluentButtonPage } from "pages/fluent_button_page.slint";
import { IconButtonPage } from "pages/icon_button_page.slint";
import { SegmentButtonPage } from "pages/segment_button_page.slint";
import { FluentTextFieldPage } from "pages/fluent_text_field_page.slint";
import { FluentTextAreaPage } from "pages/fluent_text_area_page.slint";
import { SurfacesPage } from "pages/surfaces_page.slint";
import { BadgePage } from "pages/badge_page.slint";
import { MetricCardPage } from "pages/metric_card_page.slint";
import { SettingRowPage } from "pages/setting_row_page.slint";
import { FeedbackPage } from "pages/feedback_page.slint";
import { TooltipHostPage } from "pages/tooltip_host_page.slint";
import { ToastHostPage } from "pages/toast_host_page.slint";
import { ModalManagerPage } from "pages/modal_manager_page.slint";
import { NavigationViewPage } from "pages/navigation_view_page.slint";
import { NavigationFoundationsPage } from "pages/navigation_foundations_page.slint";
import { PageHeaderPage } from "pages/page_header_page.slint";
import { SectionHeaderPage } from "pages/section_header_page.slint";
import { EmptyStatePage } from "pages/empty_state_page.slint";
import { WindowControlButtonPage } from "pages/window_control_button_page.slint";

export { GalleryNavigation, GalleryComponentLink } from "shared/gallery_catalog.slint";
export { NavigationValidationWindow } from "navigation_validation.slint";
export { KitApiProbe } from "api_probe.slint";
export { GalleryNavigationExamples } from "shared/navigation_view_specimen.slint";

// A separate, never-shown host instance leaves Palette's system binding intact.
// Its globals are independent of DesignGalleryWindow's explicit color scheme.
export component GallerySystemTheme inherits Window {
    out property <bool> system_dark: Palette.color-scheme == ColorScheme.dark;
    callback scheme_changed(bool);
    changed system_dark => { root.scheme_changed(root.system_dark); }
}

export component DesignGalleryWindow inherits Window {
    title: "Quadrant Kit Gallery";
    in property <bool> custom_chrome: false;
    out property <length> title_drag_x: title_bar.drag_x;
    out property <length> title_drag_width: title_bar.drag_width;
    out property <length> title_drag_top: root.maximized ? 0px : 5px;
    no-frame: root.custom_chrome;
    resize-border-width: root.custom_chrome && !root.maximized ? 5px : 0px;
    preferred-width: 1040px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.background;
    default-font-family: root.ui_font_family;
    default-font-size: Typography.body;
    default-font-weight: Typography.regular;

    in-out property <string> ui_font_family <=> Theme.ui_font_family;
    in-out property <string> sample_text: "Prepare a sample document";
    in-out property <bool> sample_switch: true;
    in-out property <ThemeMode> gallery_theme: ThemeMode.light;
    in-out property <string> gallery_destination <=> GalleryNavigation.selected_id;
    in-out property <int> preview_mode: 1;
    in-out property <bool> sample_modal_visible: false;
    in-out property <int> sample_modal_kind: 0;

    private property <NavigationPaneMode> pane_mode: NavigationPaneMode.expanded;

    in-out property <bool> system_dark: false;
    public function apply_theme() {
        Theme.mode = root.gallery_theme;
        Theme.system_dark = root.system_dark;
        Palette.color-scheme = Theme.dark_mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed gallery_theme => { root.apply_theme(); }
    changed system_dark => { root.apply_theme(); }

    VerticalLayout {
        spacing: 0px;
        title_bar := GalleryTitleBar {
            custom_chrome: root.custom_chrome; maximized: root.maximized;
            back_enabled: GalleryNavigation.can_go_back; pane_mode: root.pane_mode;
            gallery_theme <=> root.gallery_theme; preview_mode <=> root.preview_mode;
            back_requested => { GalleryNavigation.back_requested(); }
            pane_toggle_requested => { root.pane_mode = root.pane_mode == NavigationPaneMode.expanded ? NavigationPaneMode.compact : NavigationPaneMode.expanded; }
            minimize_requested => { root.minimized = true; }
            maximize_requested => { root.maximized = !root.maximized; }
            close_requested => { root.close(); }
        }
        NavigationView {
            vertical-stretch: 1;
            pane_width: 304px;
            pane_mode: root.pane_mode;
            items: GalleryNavigation.items;
            selected_id: GalleryNavigation.selected_id;
            show_back_button: false;
            show_pane_toggle: false;
            back_enabled: GalleryNavigation.can_go_back;
            show_search: true;
            search_placeholder: "Search pages and components";
            search_text <=> GalleryNavigation.query;
            item_invoked(id) => { GalleryNavigation.navigate(id); }
            expansion_requested(id, expanded) => { GalleryNavigation.expansion_requested(id, expanded); }
            back_requested => { GalleryNavigation.back_requested(); }
            search_changed(query) => { GalleryNavigation.query_edited(query); }
            search_submitted(query) => { GalleryNavigation.search_submitted(query); }
            pane_toggle_requested => {
                root.pane_mode = root.pane_mode == NavigationPaneMode.expanded ? NavigationPaneMode.compact : NavigationPaneMode.expanded;
            }
            VerticalLayout {
                spacing: 0px;
                if GalleryNavigation.search_status != "": HorizontalLayout {
                    height: 40px;
                    padding-left: UiConstants.space_16; padding-right: UiConstants.space_16;
                    spacing: UiConstants.space_8;
                    Text {
                        text: GalleryNavigation.search_status; color: Theme.text_secondary;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                    SegmentButton { text: "Clear search"; clicked => { GalleryNavigation.query_edited(""); } }
                }
                Rectangle {
                    vertical-stretch: 1; min-width: 0px; min-height: 0px;
                    if root.gallery_destination == "home": HomePage { width: 100%; height: 100%; }
                    if root.gallery_destination == "all-components": AllComponentsPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "tokens": TokensPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "typography": TypographyPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "icons": IconsPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "controls": ControlsPage { width: 100%; height: 100%; preview_mode: root.preview_mode; sample_text <=> root.sample_text; sample_switch <=> root.sample_switch; }
                    if root.gallery_destination == "fluent-button": FluentButtonPage { width: 100%; height: 100%; preview_mode: root.preview_mode; sample_text <=> root.sample_text; }
                    if root.gallery_destination == "icon-button": IconButtonPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "segment-button": SegmentButtonPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "fluent-text-field": FluentTextFieldPage { width: 100%; height: 100%; sample_text <=> root.sample_text; }
                    if root.gallery_destination == "fluent-text-area": FluentTextAreaPage { width: 100%; height: 100%; sample_text <=> root.sample_text; }
                    if root.gallery_destination == "surfaces": SurfacesPage { width: 100%; height: 100%; preview_mode: root.preview_mode; }
                    if root.gallery_destination == "badge": BadgePage { width: 100%; height: 100%; }
                    if root.gallery_destination == "metric-card": MetricCardPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "setting-row": SettingRowPage { width: 100%; height: 100%; sample_switch <=> root.sample_switch; }
                    if root.gallery_destination == "feedback": FeedbackPage { width: 100%; height: 100%; preview_mode: root.preview_mode; modal_requested(kind) => { root.sample_modal_kind = kind; root.sample_modal_visible = true; } }
                    if root.gallery_destination == "tooltip-host": TooltipHostPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "toast-host": ToastHostPage { width: 100%; height: 100%; preview_mode: root.preview_mode; }
                    if root.gallery_destination == "modal-manager": ModalManagerPage { width: 100%; height: 100%; modal_requested(kind) => { root.sample_modal_kind = kind; root.sample_modal_visible = true; } }
                    if root.gallery_destination == "navigation-view": NavigationViewPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "navigation-foundations": NavigationFoundationsPage { width: 100%; height: 100%; preview_mode: root.preview_mode; }
                    if root.gallery_destination == "page-header": PageHeaderPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "section-header": SectionHeaderPage { width: 100%; height: 100%; }
                    if root.gallery_destination == "empty-state": EmptyStatePage { width: 100%; height: 100%; }
                    if root.gallery_destination == "window-control-button": WindowControlButtonPage { width: 100%; height: 100%; }
                }
            }
        }
    }

    ModalManager {
        width: 100%;
        height: 100%;
        shown: root.sample_modal_visible;
        title: root.sample_modal_kind == 2 ? "Delete this item?" :
               root.sample_modal_kind == 1 ? "Apply this change?" : "Information";
        message: root.sample_modal_kind == 2 ? "This sample demonstrates a destructive confirmation; no files are changed." :
                 root.sample_modal_kind == 1 ? "This sample demonstrates a warning before applying a change." :
                 "Modal content grows with wrapped text and keeps its primary action keyboard accessible.";
        primary_text: root.sample_modal_kind == 2 ? "Delete" :
                      root.sample_modal_kind == 1 ? "Continue" : "Close";
        secondary_text: "Cancel";
        show_secondary: root.sample_modal_kind != 0;
        kind: root.sample_modal_kind == 2 ? ModalKind.danger :
              root.sample_modal_kind == 1 ? ModalKind.warning : ModalKind.info;
        danger_primary: root.sample_modal_kind == 2;
        accepted => { root.sample_modal_visible = false; }
        dismissed => { root.sample_modal_visible = false; }
    }
}
